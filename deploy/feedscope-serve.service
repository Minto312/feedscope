[Unit]
Description=feedscope: web viewer
Documentation=https://github.com/Minto312/feedscope
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/karinto/workspace/feedscope
Environment=PATH=/home/karinto/.local/bin:/usr/local/bin:/usr/bin:/bin
# loopback only. tailnet からは Tailscale Services (svc:feedscope -> 127.0.0.1:5057) 経由でだけ届く。LAN には出さない
ExecStart=/home/karinto/.local/bin/uv run feedscope --config config.yaml serve --host 127.0.0.1 --port 5057
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
